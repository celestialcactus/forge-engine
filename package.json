{
  "name": "forge-engine",
  "version": "0.1.0",
  "description": "Sovereign-first, host-neutral agent runtime for developer workflows",
  "type": "module",
  "bin": {
    "forge": "./dist/src/cli.js"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.v1.json",
    "build:product": "npm run rust:build && npm run build",
    "dev": "tsx src/cli.ts",
    "forge": "node dist/src/cli.js",
    "onboard": "npm run build:product && node dist/src/cli.js onboard",
    "release:smoke": "npm run package:smoke",
    "test": "tsx --test tests/**/*.test.ts",
    "typecheck": "tsc -p tsconfig.v1.json --noEmit && tsc -p tsconfig.scripts.json",
    "check": "npm run typecheck && npm test && npm run build",
    "smoke": "node dist/src/cli.js doctor --json && node dist/src/cli.js inspect --json --max-files 1",
    "rust:fmt": "cargo fmt --all -- --check",
    "rust:lint": "cargo clippy --workspace --all-targets --locked -- -D warnings",
    "rust:audit": "cargo audit --deny warnings",
    "rust:test": "cargo test --workspace --locked",
    "rust:build": "cargo build --workspace --locked",
    "rust:build:release": "cargo build --workspace --release --locked",
    "package:native:stage": "node scripts/stage-native-package.mjs",
    "package:native:pack": "node scripts/pack-native-package.mjs",
    "package:smoke:prepared": "node scripts/package-smoke.mjs",
    "package:smoke": "npm run rust:build:release && npm run build && node scripts/package-smoke.mjs",
    "repo:authority": "node scripts/assert-repository-authority.mjs",
    "test:hybrid": "tsx --test tests/hybrid/**/*.hybrid.ts",
    "benchmark:hybrid": "tsx scripts/benchmark-hybrid.mts",
    "check:hybrid": "npm run rust:fmt && npm run rust:lint && npm run rust:test && npm run rust:build && npm run check && npm run test:hybrid",
    "check:product": "npm run check:hybrid && npm run smoke",
    "prebuild": "node scripts/clean.mjs"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "license": "Apache-2.0",
  "devDependencies": {
    "@types/node": "22.18.1",
    "tsx": "4.20.5"
  },
  "files": [
    "dist/src",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "typescript": "5.9.2",
    "zod": "4.4.3"
  },
  "optionalDependencies": {
    "forge-engine-kernel-darwin-arm64": "0.1.0",
    "forge-engine-kernel-darwin-x64": "0.1.0",
    "forge-engine-kernel-linux-arm64": "0.1.0",
    "forge-engine-kernel-linux-x64": "0.1.0",
    "forge-engine-kernel-win32-arm64": "0.1.0",
    "forge-engine-kernel-win32-x64": "0.1.0"
  }
}
